{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run ci",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "staging": true
    }
  },
  "crons": [
    {
      "path": "/api/payload-jobs/run?allQueues=true&limit=50",
      "schedule": "0 7 * * *"
    }
  ]
}
