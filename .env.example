DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/payload-portfolio
PAYLOAD_SECRET=YOUR_SECRET_HERE
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional locally — falls back to local disk storage for uploads when unset.
# Cloudflare R2 (S3-compatible) bucket used for media storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public custom domain mapped to the R2 bucket in the Cloudflare dashboard.
# Media URLs are generated from this directly (see generateFileURL in
# payload.config.ts) so images are served straight from R2, bypassing Vercel.
R2_PUBLIC_URL=https://media.example.com
