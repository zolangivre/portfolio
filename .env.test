# Loaded by the integration tests only (see tests/setup/). Local-only
# credentials, the same as docker-compose, so this file is committed.
#
# The database is dropped and rebuilt from the migrations on every run, and
# tests/helpers/testDatabase.ts refuses to start unless DATABASE_URL points at
# a local database whose name ends in -test. Postgres creates it on first use.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/payload-portfolio-test
PAYLOAD_SECRET=integration-tests-only
# The schema must come from the migrations alone, or a migration that drifts
# from the config would be papered over by dev push.
PAYLOAD_DB_PUSH=false
# Without the R2 keys the storage plugin is off; regenerating payload-types.ts
# here would strip its fields from the committed file.
PAYLOAD_AUTOGENERATE_TYPES=false
