#!/bin/sh
# Checks the Conventional Commits format: release-please derives the version
# number and the CHANGELOG from it (.github/workflows/release.yml). A malformed
# message would be ignored, and the change would show up in no release.
#
#   feat: …            new feature         → minor version (1.1.0)
#   fix: …             bug fix             → patch (1.0.1)
#   feat!: …           breaking change     → major version (2.0.0)
#   perf|refactor|docs|test|build|ci|style|chore|revert: …
#   Optional scope: feat(admin): …
#
# One-off bypass: git commit --no-verify
first_line=$(head -n 1 "$1")

case "$first_line" in
  # Messages generated by git itself.
  "Merge "* | "Revert "* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

if printf '%s\n' "$first_line" | grep -Eq '^(feat|fix|perf|refactor|docs|test|build|ci|style|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'; then
  exit 0
fi

echo "✖ Commit message is not in Conventional Commits format:" >&2
echo "    $first_line" >&2
echo "  Expected: <type>(<optional scope>): <description>" >&2
echo "  Types   : feat, fix, perf, refactor, docs, test, build, ci, style, chore, revert" >&2
echo "  Example : feat(journal): reading progress bar" >&2
exit 1
