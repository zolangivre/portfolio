# Loaded by the Playwright suite only (playwright.config.ts). Local-only
# credentials, like .env.test, so this file is committed.
#
# Its own database, apart from the integration suite's: that one is dropped at
# the start of every `pnpm test:int`, which would pull the data out from under
# an e2e server left running. Rebuilt and seeded by tests/e2e/prepare.ts.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/payload-portfolio-e2e-test
PAYLOAD_SECRET=e2e-tests-only
PAYLOAD_DB_PUSH=false
# Without the R2 keys the storage plugin is off; regenerating payload-types.ts
# here would strip its fields from the committed file.
PAYLOAD_AUTOGENERATE_TYPES=false
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# `next build` / `next start` still read `.env`, but never override a variable
# that is already set — even to an empty string. Blanking these keeps the test
# server off the real R2 bucket and stops the contact test from emailing.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
RESEND_API_KEY=
