{
  "name": "payload-portfolio",
  "version": "1.2.0",
  "private": true,
  "description": "Zolan Givre's portfolio — Next.js and Payload CMS",
  "keywords": [
    "portfolio",
    "nextjs",
    "payload-cms",
    "react",
    "tailwindcss",
    "typescript"
  ],
  "homepage": "https://github.com/zolangivre/portfolio#readme",
  "bugs": {
    "url": "https://github.com/zolangivre/portfolio/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zolangivre/portfolio.git"
  },
  "license": "UNLICENSED",
  "author": "Zolan Givre (https://github.com/zolangivre)",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "ci": "cross-env NODE_OPTIONS=--no-deprecation payload migrate && pnpm run build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:unit && pnpm run test:int && pnpm run test:e2e",
    "test:coverage": "vitest run --project unit --coverage",
    "test:e2e": "cross-env NODE_OPTIONS=--no-deprecation playwright test --config=playwright.config.ts",
    "test:e2e:serve": "tsx tests/e2e/serve.ts",
    "test:e2e:ui": "cross-env NODE_OPTIONS=--no-deprecation playwright test --ui --project=chromium",
    "test:e2e:report": "playwright show-report",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --project int",
    "test:unit": "vitest run --project unit",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@vercel/analytics": "^2.0.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "motion": "^12.42.2",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.34.2",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.5.2",
    "@vitest/coverage-v8": "4.0.18",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.6",
    "jsdom": "28.0.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.2",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=24",
    "pnpm": "^9 || ^10 || ^11"
  },
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
